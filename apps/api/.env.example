# ── Runtime ─────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Comma-separated list of allowed browser origins (the web app)
CORS_ORIGINS=http://localhost:5173
# Set to true when served behind a reverse proxy (needed for correct client IPs / secure cookies)
TRUST_PROXY=false

# ── Database ────────────────────────────────────────────
DATABASE_URL=postgresql://ticket:ticket@localhost:5432/ticket_dev?schema=public

# ── Auth (generate with: openssl rand -base64 48) ───────
# REQUIRED in production; the server refuses to start with weak/missing secrets.
JWT_ACCESS_SECRET=change-me-dev-only-access-secret-at-least-32-chars
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
# Cookies are always HttpOnly + SameSite=Lax; Secure is forced in production.
COOKIE_SECURE=false
COOKIE_DOMAIN=
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# ── File storage ────────────────────────────────────────
# local | s3
STORAGE_DRIVER=local
# Directory outside any public web root
STORAGE_LOCAL_DIR=./storage/attachments
MAX_UPLOAD_MB=10
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# ── Email notifications ─────────────────────────────────
# Leave SMTP_HOST empty to disable email delivery (in-app notifications still work)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Support Desk <support@example.com>"
APP_URL=http://localhost:5173

# ── Background jobs ─────────────────────────────────────
SLA_MONITOR_ENABLED=true
SLA_MONITOR_INTERVAL_SECONDS=60

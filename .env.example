# Docker Compose configuration. Copy to .env and replace EVERY placeholder.
# Generate secrets with: openssl rand -base64 48

POSTGRES_DB=tickets
POSTGRES_USER=tickets
POSTGRES_PASSWORD=replace-with-a-strong-database-password

# Must be a long random value; the API refuses to start with a placeholder.
JWT_ACCESS_SECRET=

# Public URL users open in the browser (used for CORS and links in emails).
APP_URL=http://localhost:8080
WEB_PORT=8080

# First Super Admin, created on startup if it does not exist (password policy: 10+ chars, upper, lower, digit).
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# Attachments: local (Docker volume) or s3 (any S3-compatible store)
STORAGE_DRIVER=local
MAX_UPLOAD_MB=10
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Email notifications (leave SMTP_HOST empty to disable)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Support Desk <support@example.com>
